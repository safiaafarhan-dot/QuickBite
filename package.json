{
  "name": "quickbite",
  "version": "1.0.0",
  "private": true,
  "description": "QuickBite — a full-stack food ordering app (Express + SQLite + vanilla JS).",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "reset": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true})\" && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
