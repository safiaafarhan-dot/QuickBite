{
  "name": "quickbite",
  "version": "1.0.0",
  "private": true,
  "description": "QuickBite — a full-stack AI-assisted food ordering app (Express + SQLite + vanilla JS).",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:accounts": "node scripts/seed.js --accounts-only",
    "images": "node scripts/fetch-images.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:api": "node --test tests/api.test.js",
    "test:ui": "node --test tests/ui.test.js",
    "test:ai": "node --test tests/ai.test.js",
    "test:security": "node --test tests/security.test.js",
    "reset": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true})\" && npm run seed",
    "audit:deps": "npm audit --omit=dev",
    "test:browser": "node --test tests/browser.test.js",
    "test:assets": "node --test tests/assets.test.js",
    "test:startup": "node --test tests/startup.test.js",
    "qa:visual": "node scripts/visual-qa.js",
    "credits": "node scripts/fetch-images.js --credits-only",
    "build:3d": "node scripts/build-cinematic.js",
    "test:3d": "node --test tests/cinematic.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.0",
    "three": "^0.186.1"
  }
}
