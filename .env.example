# ───────────────────────────────────────────────────────────────────────
# QuickBite configuration. Copy to `.env` (or set these in your host's
# environment) and fill in real values. Never commit a filled-in .env.
# ───────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# REQUIRED in production — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (REQUIRED) ────────────────────────────────────────────────
# PostgreSQL connection string. The server refuses to start without it.
#
# Supabase → Project Settings → Database → Connection string. Use the
# "Transaction" pooler on port 6543 for Render's free web service: it holds
# far fewer server-side connections than a direct 5432 link, which is what
# the free tier's connection cap cares about.
#
#   DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Locally, a plain instance is fine:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quickbite
#
# NEVER commit a filled-in value. On Render set it in the dashboard, or mark
# it `sync: false` in render.yaml so it is entered once and not stored in git.
DATABASE_URL=

# TLS. Managed providers present a certificate this container has no root for,
# so verification is relaxed by default while the connection stays encrypted.
# Set PGSSL_STRICT=1 (with PGSSLROOTCERT) to verify properly, or
# PGSSL_DISABLE=1 for a local server with no TLS at all.
# PGSSL_STRICT=0
# PGSSL_DISABLE=0

# Pool size. Supabase's free tier caps connections, and Render's free instance
# is small; 8 is a sensible ceiling for one web service.
# PGPOOL_MAX=8

# Used by the test suite only. Point it at a database you do not mind being
# written to and dropped from — the suites create and remove their own schemas.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quickbite_test

# Number of proxy hops in front of the app, so rate limiting sees the real
# client IP. 0 when the app is exposed directly; 1 behind a single reverse proxy.
TRUST_PROXY_HOPS=0

# ── Rate limiting ──────────────────────────────────────────────────────
# Sign-in / registration attempts per window, per IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Overall API requests per minute, per IP.
API_RATE_LIMIT_MAX=300

# ── AI (entirely optional) ─────────────────────────────────────────────
# The recommender and analytics always work with no key at all. A key only
# changes HOW the menu assistant phrases its answer — the dishes it names are
# always chosen from the database by server-side rules either way.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_TIMEOUT_MS=8000

# ── Payments ───────────────────────────────────────────────────────────
# Leave as `sandbox` to run the built-in mock gateway. No real money moves.
PAYMENT_PROVIDER=sandbox
# REQUIRED for the webhook to accept anything at all. The sandbox uses it to
# sign simulated callbacks; a real gateway uses it to sign genuine ones.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Logging ────────────────────────────────────────────────────────────
# Set to 1 to silence the per-request JSON access log.
# QUICKBITE_QUIET=0
